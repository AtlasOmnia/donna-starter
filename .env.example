# Copy this file to .env and fill in the keys you need.
#   cp .env.example .env
# Never share or commit this file — it holds credentials.
# `hermes setup` can configure your main model provider for you; these
# variables are for anything you want to set directly.

# --- Model provider (pick the one you use) ---
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Reddit (required for the reddit-browse-and-post skill) ---
# Create a "script" app at https://www.reddit.com/prefs/apps first.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USERNAME=
# REDDIT_PASSWORD=

# --- Optional: any other provider or integration keys ---
